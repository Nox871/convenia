# Copiar a `.env` y completar con credenciales reales. Nunca commitear `.env`.

# --- Base de datos (compartida por backend/ y etl/) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=convenia
DB_USER=postgres
DB_PASSWORD=

# --- Backend (backend/app/core/config.py) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
DATA_FRESHNESS_THRESHOLD_HOURS=48
WALKING_SPEED_KMH=4.5

# --- Autenticación (backend/app/core/security.py) ---
# Genera un valor propio, largo y aleatorio -- nunca uses el de este
# ejemplo. En Python: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=720
# Client ID de tipo "Aplicación web" de Google Cloud Console (Google Sign-In).
GOOGLE_WEB_CLIENT_ID=

# --- ETL: ciclo de vida de producto (etl/config.py) ---
PRODUCT_DISCONTINUATION_THRESHOLD_DAYS=30
MIN_PRODUCTS_RATIO_VS_HISTORY=0.5

# --- Homologación (etl/homologacion/matcher.py) ---
MATCH_CONFIRM_THRESHOLD=0.80
MATCH_REVIEW_THRESHOLD=0.55

# Correos que quedan como administradores al iniciar sesión (separados por comas).
# Sólo sube de rol; quitar un correo no le quita el rol a quien ya lo tiene.
ADMIN_EMAILS=

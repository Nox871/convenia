# Copiar a `.env` y completar con credenciales reales. Nunca commitear `.env`.

# --- Base de datos (compartida por backend/ y etl/) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=convenia
DB_USER=postgres
DB_PASSWORD=

# --- Backend (backend/app/core/config.py) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
DATA_FRESHNESS_THRESHOLD_HOURS=48
WALKING_SPEED_KMH=4.5

# --- ETL: ciclo de vida de producto (etl/config.py, ERS §54) ---
PRODUCT_DISCONTINUATION_THRESHOLD_DAYS=30
MIN_PRODUCTS_RATIO_VS_HISTORY=0.5

# --- Homologación (etl/homologacion/matcher.py) ---
MATCH_CONFIRM_THRESHOLD=0.80
MATCH_REVIEW_THRESHOLD=0.55
